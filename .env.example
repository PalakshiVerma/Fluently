# Gemma Hosted Model API Configuration
# Options:
# 1. Google AI Studio / Gemini API (e.g., GEMMA_PROVIDER=google, GEMMA_MODEL=gemma-2-9b-it or gemma-2-27b-it)
# 2. OpenRouter (e.g., GEMMA_PROVIDER=openrouter, GEMMA_MODEL=google/gemma-2-9b-it)
# 3. Groq (e.g., GEMMA_PROVIDER=groq, GEMMA_MODEL=gemma2-9b-it)
# 4. HuggingFace Inference API (e.g., GEMMA_PROVIDER=huggingface, GEMMA_MODEL=google/gemma-2-9b-it)

GEMMA_PROVIDER=groq
GEMMA_API_KEY=your_api_key_here
GEMMA_MODEL=gemma2-9b-it

# Application Settings
APP_ENV=development
APP_PORT=8501
DEFAULT_TIMEZONE=UTC
